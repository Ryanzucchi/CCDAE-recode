{
  "name": "geoveil/geoveil",
  "version": "2.0.0-dev",
  "description": "Declarative geospatial workspaces for Laravel",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0",
